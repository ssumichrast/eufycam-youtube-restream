# Copy this file to .env and fill in your values.
# .env should NOT be committed to git (it holds your camera and stream credentials).

# --- Eufycam RTSP source -----------------------------------------------
# Host[:port]/path from the Eufy Security app's "Local RTSP Live Stream"
# feature. The rtsp:// prefix is optional here, it's stripped either way.
CAMERA_RTSP_ADDRESS=192.168.1.50:554/live0
CAMERA_USERNAME=admin
CAMERA_PASSWORD=changeme

# --- YouTube Live destination -------------------------------------------
# From YouTube Studio > Go Live > Stream settings.
YOUTUBE_INGEST_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=xxxx-xxxx-xxxx-xxxx-xxxx

# --- Optional tuning (defaults shown, safe to leave commented out) -----
# RETRY_DELAY_SECONDS=10        # wait time before restarting ffmpeg after it exits
# RTSP_TRANSPORT=tcp            # tcp | udp
# VIDEO_MODE=copy               # copy (no re-encode) | encode (transcode to H.264)
# VIDEO_BITRATE=4000k           # only used when VIDEO_MODE=encode
# IO_TIMEOUT_US=15000000        # network read/write timeout in microseconds
#
# The camera's microphone is never streamed. AUDIO_MODE only chooses what
# stand-in track accompanies the video:
#   silent (default) - a generated silent track. YouTube Live expects an
#                      audio stream to exist, so this is what you want.
#   none             - no audio track at all. YouTube will often refuse to
#                      go live; escape hatch only.
# AUDIO_MODE=silent
